# PlanWise Environment Configuration Example

# Backend
PORT=5000
DATABASE_URL="file:./dev.db" # Or postgresql://user:password@localhost:5432/planwise
JWT_SECRET="your-secure-jwt-secret-key-at-least-32-chars"
CORS_ORIGIN="http://localhost:5173"
NODE_ENV="development"

# Optional External API Services
# If omitted or left empty, PlanWise operates automatically in DEMO MODE with realistic seeded data
GOOGLE_MAPS_API_KEY=""
GOOGLE_PLACES_API_KEY=""
GOOGLE_ROUTES_API_KEY=""
